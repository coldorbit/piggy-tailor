# App
FLASK_ENV=production
HOST_PORT=5000
PORT=5000

# OpenAI
OPENAI_API_KEY=sk-your-api-key-here
# Used by docker-compose.balanced.yml for two-container round-robin mode.
OPENAI_API_KEY_1=sk-your-first-api-key-here
OPENAI_API_KEY_2=sk-your-second-api-key-here
OPENAI_TIMEOUT_SECONDS=150
GUNICORN_TIMEOUT=180

# PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
MIGRATE_PROFILES_FROM_YAML=true

# Generated resume storage
RESUME_S3_BUCKET=your-resume-bucket
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Container image used by docker compose on EC2.
# Local development can leave this unset and run: docker compose up --build
IMAGE=ghcr.io/GITHUB_OWNER/GITHUB_REPOSITORY:latest
